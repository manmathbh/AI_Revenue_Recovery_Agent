# Recoup environment configuration — copy to .env and fill in values.
# Secrets are never committed; this file documents names only.

# --- Database (PostgreSQL 16) ---
# docker compose exposes postgres on 5432; local Homebrew PG also works.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoup

# --- Razorpay (test mode keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_for_local_testing

# --- LLM (OpenAI-compatible, provider-swappable) ---
# Leave LLM_API_KEY empty to force deterministic FALLBACK decisions everywhere.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Admin / dashboard auth ---
ADMIN_API_KEY=change-me-to-a-32-byte-random-string

# --- App ---
APP_ENV=dev
